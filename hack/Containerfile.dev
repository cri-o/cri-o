FROM registry.access.redhat.com/ubi9/ubi:9.8

RUN dnf install -y \
    autoconf \
    automake \
    gcc \
    git \
    glib2-devel \
    glibc-static \
    gpgme-devel \
    libassuan-devel \
    libcap-devel \
    libseccomp-devel \
    libtool \
    make \
    pkgconfig \
    && dnf clean all

# Install Go. Keep GOVERSION in sync with go.mod, and update the pinned
# checksums below when bumping it (see https://go.dev/dl/?mode=json&include=all).
ARG TARGETARCH
ENV GOVERSION=1.27.2
RUN case "${TARGETARCH}" in \
        amd64)   GO_SHA256=ecbadb99091a3f46e31f5f934b068b1864eafa7995211b39eaddf76996045fe5 ;; \
        arm64)   GO_SHA256=94f3e30b8e374bc285e7dadc11e0865726b9bc6e85b841ccceaabc0214c6b7c8 ;; \
        ppc64le) GO_SHA256=059d5f01b1607a724ea5ae87c5589041a51c577a6f3f20099e49d00f31c803fa ;; \
        s390x)   GO_SHA256=dfd01d1e08e4dbece2cd91e259953f87b858752037fd151da2f674c4fa09aeef ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH:-unset}" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://go.dev/dl/go${GOVERSION}.linux-${TARGETARCH}.tar.gz" -o /tmp/go.tar.gz && \
    echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum -c - && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm -f /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /src
