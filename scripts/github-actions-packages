#!/usr/bin/env bash
set -euo pipefail

# Packages needed to run the integration tests. The CRI-O and test binaries
# link against libgpgme and libseccomp, crun as built by
# scripts/github-actions-setup against the others.
RUNTIME_PACKAGES=(
    conmon
    libcap-dev
    libglib2.0-dev
    libgpgme11-dev
    libjson-c-dev
    libseccomp-dev
    libsystemd-dev
    socat
)

# Packages only needed to build and unit test CRI-O. The unit tests also use
# criu, the integration tests only for the checkpoint tests, which require runc
# and pass "criu" as second argument.
BUILD_PACKAGES=(
    autoconf
    automake
    libaio-dev
    libapparmor-dev
    libbtrfs-dev
    libdevmapper-dev
    libfuse-dev
    libnet1-dev
    libnl-3-dev
    libprotobuf-c-dev
    libprotobuf-dev
    libtool
    libudev-dev
    libyajl-dev
    make
    sed
    uuid-dev
    wget
)

PACKAGES=("${RUNTIME_PACKAGES[@]}")
INSTALL_CRIU=${2:-}
if [[ "${1:-}" != runtime ]]; then
    PACKAGES+=("${BUILD_PACKAGES[@]}")
    INSTALL_CRIU=criu
fi

if [[ "$INSTALL_CRIU" == criu ]]; then
    PACKAGES+=(criu)

    . /etc/os-release
    CRIU_REPO="https://download.opensuse.org/repositories/devel:/tools:/criu/xUbuntu_$VERSION_ID"

    sudo install -d -m 0755 /etc/apt/keyrings
    curl -fSsL "$CRIU_REPO/Release.key" | sudo tee /etc/apt/keyrings/criu.asc >/dev/null
    sudo chmod 0644 /etc/apt/keyrings/criu.asc
    echo "deb [signed-by=/etc/apt/keyrings/criu.asc] $CRIU_REPO/ /" | sudo tee /etc/apt/sources.list.d/criu.list
fi

sudo apt update
sudo apt install -y "${PACKAGES[@]}"
